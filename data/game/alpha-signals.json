{
  "version": "0.1",
  "project": "Bird Squad",
  "basedOn": [
    "docs/game/alpha-run-spec.md",
    "docs/game/next-level-data-contracts.md"
  ],
  "signals": [
    {
      "id": "faded_chalk_line",
      "title": "Faded Chalk Line",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "An old route mark is still visible under rain grime, but reaching it means crossing an exposed billboard frame.",
      "choices": [
        { "key": "repaint", "text": "Repaint the mark.", "outcomes": ["loseCohesion(4)", "gainRouteMark(chalk_wingmark)"] },
        { "key": "scout", "text": "Send a fast scout.", "outcomes": ["gainScrap(45)", "addSnagToDiscard(bad_directions)"] },
        { "key": "move", "text": "Keep moving.", "outcomes": ["gainScrap(20)"] }
      ]
    },
    {
      "id": "loose_wire_perch",
      "title": "Loose Wire Perch",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A broken wire perch can become a shortcut if the flock spends time and Scrap to stabilize it.",
      "choices": [
        { "key": "repair", "text": "Repair it.", "requirements": ["scrapAtLeast(50)"], "lockedText": "Need 50 Scrap.", "outcomes": ["payScrap(50)", "gainRouteMark(rooftop_shortcut)"] },
        { "key": "strip", "text": "Strip it for parts.", "outcomes": ["gainScrap(60)", "loseCohesion(3)"] },
        { "key": "leave", "text": "Leave it.", "outcomes": [] }
      ]
    },
    {
      "id": "rain_barrel_watch",
      "title": "Rain Barrel Watch",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A hidden barrel still holds clean rainwater, but a lookout warns that the route ahead is watched.",
      "choices": [
        { "key": "rest", "text": "Rest and refill.", "outcomes": ["healCohesion(8)", "enemyCoverNextCombat(4)"] },
        { "key": "trade", "text": "Trade the location.", "outcomes": ["gainScrap(35)", "gainSupply(random)"] },
        { "key": "mark", "text": "Mark it for later.", "outcomes": ["gainSupplyChoice(1)"] }
      ]
    },
    {
      "id": "rooftop_courier",
      "title": "Rooftop Courier",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A tired courier offers a shortcut in exchange for help clearing a Snag from its own route.",
      "choices": [
        { "key": "help", "text": "Help the courier.", "outcomes": ["preenCard(1)", "addSnagToDraw(tangled_line)"] },
        { "key": "pay", "text": "Pay for the shortcut.", "requirements": ["scrapAtLeast(40)"], "lockedText": "Need 40 Scrap.", "outcomes": ["payScrap(40)", "gainRouteMark(rooftop_shortcut)"] },
        { "key": "invite", "text": "Invite the courier.", "outcomes": ["addCard(randomCommonPlumesOrQuills)"] }
      ]
    },
    {
      "id": "blackout_sign",
      "title": "Blackout Sign",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A dead neon sign blocks the route. Cutting through it could reveal a cache, but the flock will cross under Open Sky.",
      "choices": [
        { "key": "cut", "text": "Cut through.", "outcomes": ["startNextCombatOpenSky()", "gainCacheReward()"] },
        { "key": "around", "text": "Go around.", "outcomes": ["gainScrap(30)"] },
        { "key": "patch", "text": "Patch the sign.", "requirements": ["scrapAtLeast(30)"], "lockedText": "Need 30 Scrap.", "outcomes": ["payScrap(30)", "gainSupply(signal_flare)"] }
      ]
    },
    {
      "id": "rooftop_rival_corvids",
      "title": "Rival Corvids' Toll",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A scrappy crew of corvids has claimed this tar roof. They offer passage — or a wager.",
      "choices": [
        { "key": "wager", "text": "Challenge them to a race.", "outcomes": ["gainOpenSkyGuard(2)", "gainScrap(40)"] },
        { "key": "pay_tribute", "text": "Leave a seed offering.", "requirements": ["hasSupplySlot()"], "lockedText": "Need an empty supply slot.", "outcomes": ["gainSupply(seed_packet)", "loseCohesion(2)"] },
        { "key": "sneak", "text": "Slip through at dusk.", "outcomes": ["addSnagToDiscard(bad_directions)", "gainScrap(25)"] }
      ]
    },
    {
      "id": "rooftop_water_main_burst",
      "title": "Water Main Burst",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "A ruptured water main floods the tar. The downpour offers cover, but the flock will be soaked for the next fight.",
      "choices": [
        { "key": "cross_wet", "text": "Cross while wet.", "outcomes": ["addSnagToDraw(wet_feathers)", "reduceNextOpenSky(3)", "gainScrap(50)"] },
        { "key": "shelter", "text": "Shelter under an awning.", "outcomes": ["healMissingPct(30)", "gainSupplyChoice(1)"] },
        { "key": "ride_flow", "text": "Ride the water downslope.", "requirements": ["cohesionAtLeast(8)"], "lockedText": "Need 8+ Cohesion.", "outcomes": ["loseCohesion(6)", "gainRouteMark(randomNonBoss)"] }
      ]
    },
    {
      "id": "rooftop_tangled_antenna",
      "title": "Tangled Antenna",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "An old TV antenna has caught cables and netting. Clearing it might yield scrap — or a card from someone's nest.",
      "choices": [
        { "key": "harvest", "text": "Strip it for metal.", "outcomes": ["gainScrap(55)", "releaseCard(1)"] },
        { "key": "untangle", "text": "Untangle carefully.", "outcomes": ["addCard(randomCommon)", "preenCard(1)"] },
        { "key": "leave", "text": "Leave it tied.", "outcomes": ["gainSupply(zip_tie_roll)", "loseCohesion(1)"] }
      ]
    },
    {
      "id": "rooftop_thermal_updraft",
      "title": "Thermal Updraft",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "Heat rising off dark tar creates a warm current. The flock could ride it to recover, but it will carry them into a hot zone.",
      "choices": [
        { "key": "ride_updraft", "text": "Ride the updraft.", "outcomes": ["startNextCombatOpenSky()", "healCohesion(10)"] },
        { "key": "ground", "text": "Stay grounded.", "outcomes": ["gainOpenSkyGuard(3)"] },
        { "key": "rest", "text": "Rest in the warmth.", "requirements": ["cohesionBelowPct(60)"], "lockedText": "Only when the flock is battered.", "outcomes": ["healMissingPct(50)"] }
      ]
    },
    {
      "id": "rooftop_pigeon_stash",
      "title": "Pigeon's Hidden Stash",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "Behind a loose drainpipe, an old pigeon has cached supplies and cards. Sharing means splitting the haul.",
      "choices": [
        { "key": "partner", "text": "Partner with the pigeon.", "outcomes": ["addCard(chooseOneOfTwoCommon)", "gainScrap(35)", "loseCohesion(3)"] },
        { "key": "take_supplies", "text": "Take just the supplies.", "requirements": ["hasSupplySlot()"], "lockedText": "Need an empty supply slot.", "outcomes": ["gainSupplyChoice(1)", "addSnagToDiscard(tangled_line)"] },
        { "key": "thank_leave", "text": "Thank and leave.", "outcomes": ["healCohesion(6)"] }
      ]
    },
    {
      "id": "rooftop_chalk_smudge",
      "title": "Chalk Smudge",
      "mapId": "map_01_rooftop_blocks",
      "prompt": "An old mark has been half-erased. You could reinterpret it, or search the tar for what is hidden beneath.",
      "choices": [
        { "key": "redraw", "text": "Redraw the mark.", "outcomes": ["gainRouteMark(loose_change_tin)", "loseCohesion(2)"] },
        { "key": "dig", "text": "Dig under the tar.", "outcomes": ["gainScrap(65)", "addSnagToDraw(wet_feathers)"] },
        { "key": "ponder", "text": "Decipher the smudge.", "requirements": ["scrapAtLeast(25)"], "lockedText": "Need 25 Scrap for materials.", "outcomes": ["payScrap(25)", "gainCacheReward()"] }
      ]
    }
  ]
}
